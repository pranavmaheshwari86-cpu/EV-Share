# EV Share Environment Configuration Example
# Copy this file to .env and adjust variables as appropriate.

DJANGO_SECRET_KEY=evshare-secret-key-change-this-in-production-random-value-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# MongoDB Configuration
# For local standalone or Atlas, set MONGODB_URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ev_share?retryWrites=true&w=majority
# If left empty, local development / tests use mongomock or localhost:27017
MONGODB_URI=mongodb://localhost:27017/ev_share
MONGODB_DATABASE=ev_share

# Server Port
PORT=8000

# Email Configuration (Optional / Console fallback)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@evshare.in

# Map Configuration (Esri World Street Map — high performance CDN, zero API keys, no 403 localhost blocks)
MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
MAP_TILE_ATTRIBUTION=Tiles &copy; Esri &mdash; Source: Esri, DeLorme, NAVTEQ, USGS, Intermap, iPC, METI, TomTom
MAP_TILE_SUBDOMAINS=
MAP_TILE_MAX_ZOOM=19

